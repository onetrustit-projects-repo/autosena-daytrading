# Server Configuration
PORT=3000
NODE_ENV=development

# MetaTrader Connector Security
# This secret must match the CONFIG_SECRET in your MQL5 EA
MT_CONNECTOR_SECRET=ea-secret-key

# Optional: MongoDB connection (for production)
# MONGODB_URI=mongodb://localhost:27017/autosena

# Optional: Redis for caching (for production)
# REDIS_URL=redis://localhost:6379
